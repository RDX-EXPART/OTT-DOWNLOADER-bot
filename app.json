{
  "name": "OTT-DOWNLOADER",
  "description": "Telegram bot for downloading OTT content with Widevine DRM decryption.",
  "repository": "https://github.com/RDX-EXPART/OTT-DOWNLOADER-bot",
  "logo": "https://telegram.org/img/t_logo.png",
  "keywords": ["telegram", "bot", "pyrogram", "ott", "downloader"],
  "env": {
    "BOT_TOKEN": { "description": "Telegram Bot Token from @BotFather", "required": true },
    "API_ID": { "description": "Telegram API ID from my.telegram.org", "required": true },
    "API_HASH": { "description": "Telegram API HASH from my.telegram.org", "required": true },
    "OWNER_ID": { "description": "Telegram User ID of the bot owner", "required": true },
    "DB_URL": { "description": "MongoDB URI connection string", "required": true },
    "LOG_CHANNEL": { "description": "Telegram Channel ID for bot logs", "required": false },
    "SESSION_STRING": { "description": "Pyrogram string session for 4GB upload", "required": false },
    "PROXY": { "description": "Proxy URL if required", "required": false }
  },
  "formation": {
    "worker": { "quantity": 1 }
  },
  "buildpacks": [
    { "url": "https://github.com/heroku/heroku-buildpack-apt" },
    { "url": "heroku/python" }
  ]
}
